JWT_SECRET=
DATABASE_CREDENTIALS_KEY=
CORS_ORIGIN=https://db-metrics-front.vercel.app,https://dbmetrics.com.br
LOG_LEVEL=info
PUBLIC_REGISTRATION_ENABLED=false
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=
PUBLIC_WEB_URL=http://localhost:3000
# Maximum time in milliseconds for GET /ready to check the primary database.
APP_READINESS_TIMEOUT_MS=2000
# Lifetime of refresh sessions and the HttpOnly refresh cookie, in days.
REFRESH_TOKEN_TTL_DAYS=30

#######################################
# Bootstrap
#######################################

ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@dbmetrics.local
ADMIN_PASSWORD=ChangeMe123!

# Enables automatic metrics collection. Accepted values: true or false.
DATABASE_METRICS_SCHEDULER_ENABLED=false
# Six-field cron expression used by the database metrics scheduler.
DATABASE_METRICS_CRON=0 */5 * * * *
# Maximum time in milliseconds for database metric connections and queries.
DATABASE_METRICS_CONNECTION_TIMEOUT_MS=10000
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=

# Alert delivery mode. When disabled the legacy synchronous flow remains active.
ALERT_ASYNC_DELIVERY_ENABLED=false
RABBITMQ_URL=amqp://127.0.0.1:5672
ALERT_OUTBOX_POLL_INTERVAL_MS=5000
ALERT_OUTBOX_MAX_ATTEMPTS=5
ALERT_OUTBOX_RETRY_BASE_DELAY_MS=1000
ALERT_OUTBOX_RETRY_MAX_DELAY_MS=300000
ALERT_OUTBOX_LEASE_MS=60000
