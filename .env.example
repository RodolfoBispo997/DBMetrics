# Six-field cron expression used by the database metrics scheduler.
DATABASE_METRICS_CRON=0 */5 * * * *
# Maximum time in milliseconds for database metric connections and queries.
DATABASE_METRICS_CONNECTION_TIMEOUT_MS=10000
