
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum UserRole {
  ADMIN
  MEMBER
  VIEWER
}

enum DatabaseProvider {
  MYSQL
  POSTGRESQL
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(ADMIN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connections DatabaseConnection[]

  @@map("users")
}

model DatabaseConnection {
  id String @id @default(uuid())
  name String
  provider DatabaseProvider
  host String
  port Int 
  database String
  username String
  password String


  user User @relation(fields: [userId], references: [id])
  userId String

  metrics DatabaseMetric[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  

  @@map("database_connections")
  @@index([userId])


}

model DatabaseMetric {
  id                   String   @id @default(uuid())
  databaseConnectionId String
  databaseVersion      String
  tablesCount          Int
  viewsCount           Int
  schemasCount         Int
  indexesCount         Int
  functionsCount       Int
  databaseSize         Int
  activeConnections    Int
  createdAt            DateTime @default(now())

  databaseConnection DatabaseConnection @relation(fields: [databaseConnectionId], references: [id], onDelete: Cascade)

  @@index([databaseConnectionId, createdAt])
  @@map("database_metrics")
}

