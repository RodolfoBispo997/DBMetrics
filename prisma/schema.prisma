
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum UserRole {
  ADMIN
  MEMBER
  VIEWER
}

enum DatabaseProvider {
  MYSQL
  POSTGRESQL
}

enum AlertMetric {
  DATABASE_SIZE
  ACTIVE_CONNECTIONS
  TABLES_COUNT
  VIEWS_COUNT
  SCHEMAS_COUNT
  INDEXES_COUNT
  FUNCTIONS_COUNT
}

enum AlertOperator {
  GREATER_THAN
  GREATER_THAN_OR_EQUAL
  LESS_THAN
  LESS_THAN_OR_EQUAL
  EQUAL
  NOT_EQUAL
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  DISCORD
  WEBHOOK
}

enum AlertExecutionStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(ADMIN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connections DatabaseConnection[]

  @@map("users")
}

model DatabaseConnection {
  id String @id @default(uuid())
  name String
  provider DatabaseProvider
  host String
  port Int 
  database String
  username String
  password String


  user User @relation(fields: [userId], references: [id])
  userId String

  metrics DatabaseMetric[]

  alertRules AlertRule[]

  alertExecutions AlertExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  

  @@map("database_connections")
  @@index([userId])


}

model DatabaseMetric {
  id                   String   @id @default(uuid())
  databaseConnectionId String
  databaseVersion      String
  tablesCount          Int
  viewsCount           Int
  schemasCount         Int
  indexesCount         Int
  functionsCount       Int
  databaseSize         Int
  activeConnections    Int
  createdAt            DateTime @default(now())

  alertExecutions AlertExecution[]

  databaseConnection DatabaseConnection @relation(fields: [databaseConnectionId], references: [id], onDelete: Cascade)

  @@index([databaseConnectionId, createdAt])
  @@map("database_metrics")
}


model AlertRule {
  id String @id @default(uuid())
  metric AlertMetric
  operator AlertOperator
  threshold Float
  channel NotificationChannel
  enabled Boolean @default(true)
  

  databaseConnectionId String
  databaseConnection   DatabaseConnection @relation(fields: [databaseConnectionId], references: [id], onDelete: Cascade)
  destination String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alertExecutions AlertExecution[]
  

  @@index([databaseConnectionId])
  @@map("alert_rules")
}

model AlertExecution {
  id String @id @default(uuid())

  alertRuleId String
  alertRule AlertRule @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)

  databaseMetricId String
  databaseMetric DatabaseMetric @relation(fields: [databaseMetricId], references: [id], onDelete: Cascade)

  databaseConnectionId String

  databaseConnection DatabaseConnection @relation(fields: [databaseConnectionId], references: [id], onDelete: Cascade)

  connectionName String
  databaseProvider DatabaseProvider
  host String
  databaseName String
  port Int
  metric AlertMetric
  operator AlertOperator
  metricValue Float
  threshold Float
  channel NotificationChannel
  destination String
  status AlertExecutionStatus @default(PENDING)
  errorMessage String?
  triggeredAt DateTime @default(now())
  sentAt DateTime?

  
  @@index([databaseConnectionId])
  @@index([alertRuleId])
  @@index([status])
  @@map("alert_executions")
}